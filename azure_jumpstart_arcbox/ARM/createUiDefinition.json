                "Standard_D32ads_v6",
                "Standard_D48ads_v6",
                "Standard_D64ads_v6",
                "Standard_D16alds_v6",
                "Standard_D32alds_v6",
                "Standard_D48alds_v6",
                "Standard_D64alds_v6",
                "Standard_D16als_v6",
                "Standard_D32als_v6",
