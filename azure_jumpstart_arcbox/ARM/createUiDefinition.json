                "Standard_E8as_v6",
                "Standard_E16as_v6",
                "Standard_E20as_v6",
                "Standard_E32as_v6",
                "Standard_E48as_v6",
                "Standard_E64as_v6",
                "Standard_E8ds_v6",
                "Standard_E16ds_v6",
                "Standard_E20ds_v6",
                "Standard_E32ds_v6",
                "Standard_E48ds_v6",
                "Standard_E64ds_v6",
                "Standard_E8s_v6",
                "Standard_E16s_v6",
                "Standard_E20s_v6",
                "Standard_E32s_v6",
                "Standard_E48s_v6",
                "Standard_E64s_v6",
                "Standard_D8ads_v7",
                "Standard_D16ads_v7",
                "Standard_D32ads_v7",
