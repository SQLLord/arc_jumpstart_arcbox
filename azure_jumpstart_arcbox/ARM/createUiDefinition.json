                "Standard_D64lds_v7",
                "Standard_D16ls_v7",
                "Standard_D32ls_v7",
                "Standard_D48ls_v7",
                "Standard_D64ls_v7",
                "Standard_D8s_v7",
                "Standard_D16s_v7",
                "Standard_D32s_v7",
                "Standard_D48s_v7",
                "Standard_D64s_v7",
                "Standard_E8ads_v7",
                "Standard_E16ads_v7",
                "Standard_E32ads_v7",
                "Standard_E48ads_v7",
                "Standard_E64ads_v7",
                "Standard_E8as_v7",
                "Standard_E16as_v7",
                "Standard_E32as_v7",
                "Standard_E48as_v7",
                "Standard_E64as_v7",
                "Standard_E8ds_v7",
                "Standard_E16ds_v7",
                "Standard_E20ds_v7",
                "Standard_E32ds_v7",
                "Standard_E48ds_v7",
                "Standard_E64ds_v7",
                "Standard_E8s_v7",
                "Standard_E16s_v7",
                "Standard_E20s_v7",
                "Standard_E32s_v7",
                "Standard_E48s_v7",
                "Standard_E64s_v7"
              ]
            },
            "osPlatform": "Windows",
            "imageReference": {
              "publisher": "MicrosoftWindowsServer",
              "offer": "WindowsServer",
              "sku": "2025-datacenter-g2"
            },
            "count": 1
          },
          {
            "name": "zones",
            "type": "Microsoft.Common.DropDown",
            "label": "Availability zone",
            "defaultValue": "1",
            "constraints": {
              "allowedValues": [
                {
                  "label": "1",
                  "value": "1"
                },
                {
                  "label": "2",
                  "value": "2"
                },
                {
                  "label": "3",
                  "value": "3"
                }
              ],
              "required": true
            }
          },
          {
            "name": "enableAzureSpotPricing",
            "type": "Microsoft.Common.CheckBox",
            "label": "Use Azure Spot pricing for the client VM"
          },
          {
            "name": "vmAutologon",
            "type": "Microsoft.Common.CheckBox",
            "defaultValue": true,
            "label": "Enable autologon (runs the setup scripts automatically after reboot)"
          },
          {
            "name": "autoShutdownEnabled",
            "type": "Microsoft.Common.CheckBox",
            "label": "Enable daily auto-shutdown",
            "defaultValue": true
          },
          {
            "name": "autoShutdownTime",
            "type": "Microsoft.Common.TextBox",
            "label": "Auto-shutdown time (HHmm)",
            "defaultValue": "1800",
            "visible": "[steps('vm').autoShutdownEnabled]",
            "constraints": {
              "required": true,
              "regex": "^([01][0-9]|2[0-3])[0-5][0-9]$",
              "validationMessage": "24-hour time as HHmm, for example 1800."
            }
          },
          {
            "name": "autoShutdownTimezone",
            "type": "Microsoft.Common.TextBox",
            "label": "Auto-shutdown time zone",
            "defaultValue": "UTC",
            "visible": "[steps('vm').autoShutdownEnabled]",
            "toolTip": "Windows time zone ID, for example \"UTC\" or \"Pacific Standard Time\".",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "autoShutdownEmailRecipient",
            "type": "Microsoft.Common.TextBox",
            "label": "Auto-shutdown notification email (optional)",
            "visible": "[steps('vm').autoShutdownEnabled]",
            "constraints": {
              "required": false
            }
          }
        ]
      },
      {
        "name": "network",
        "label": "Networking",
        "elements": [
          {
            "name": "deployNatGateway",
            "type": "Microsoft.Common.CheckBox",
            "label": "Deploy a NAT Gateway for outbound internet access",
            "toolTip": "Required where policy blocks default outbound access. Always deployed with Bastion or the DevOps/DataOps flavors."
          },
          {
            "name": "deployBastion",
            "type": "Microsoft.Common.CheckBox",
            "label": "Deploy Azure Bastion (client VM gets no public IP)"
          },
          {
            "name": "bastionSku",
            "type": "Microsoft.Common.DropDown",
            "label": "Bastion SKU",
            "defaultValue": "Basic",
            "visible": "[steps('network').deployBastion]",
            "constraints": {
              "allowedValues": [
                {
                  "label": "Basic",
                  "value": "Basic"
                },
                {
                  "label": "Standard",
                  "value": "Standard"
                },
                {
                  "label": "Developer",
                  "value": "Developer"
                }
              ],
              "required": true
            }
          },
          {
            "name": "rdpPort",
            "type": "Microsoft.Common.TextBox",
            "label": "RDP port",
            "defaultValue": "3389",
            "constraints": {
              "required": true,
              "regex": "^[0-9]{2,5}$",
              "validationMessage": "A port number."
            }
          }
        ]
      },
      {
        "name": "advanced",
        "label": "Advanced",
        "elements": [
          {
            "name": "githubAccount",
            "type": "Microsoft.Common.TextBox",
            "label": "GitHub account hosting arc_jumpstart_arcbox",
            "defaultValue": "SQLLord",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "githubBranch",
            "type": "Microsoft.Common.TextBox",
            "label": "GitHub branch",
            "defaultValue": "master",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "githubUser",
            "type": "Microsoft.Common.TextBox",
            "label": "GitHub account hosting jumpstart-apps (DevOps only)",
            "defaultValue": "Azure",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "vhdStorageAccountName",
            "type": "Microsoft.Common.TextBox",
            "label": "VHD storage account (empty = public Jumpstart storage)",
            "defaultValue": "arcboxfilesdonotdelete",
            "constraints": {
              "required": false
            }
          },
          {
            "name": "vhdStorageAccountResourceGroup",
            "type": "Microsoft.Common.TextBox",
            "label": "VHD storage account resource group",
            "defaultValue": "Arcbox",
            "visible": "[not(empty(steps('advanced').vhdStorageAccountName))]",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "vhdContainerName",
            "type": "Microsoft.Common.TextBox",
            "label": "VHD container",
            "defaultValue": "arcboxvhds",
            "visible": "[not(empty(steps('advanced').vhdStorageAccountName))]",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "keyVaultName",
            "type": "Microsoft.Common.TextBox",
            "label": "Key Vault name (empty = auto-generated)",
            "constraints": {
              "required": false,
              "regex": "^$|^[A-Za-z][A-Za-z0-9-]{1,22}[A-Za-z0-9]$",
              "validationMessage": "3-24 letters, numbers or hyphens, starting with a letter."
            }
          },
          {
            "name": "debugEnabled",
            "type": "Microsoft.Common.CheckBox",
            "label": "Debug mode for the automation scripts"
          }
        ]
      }
    ],
    "outputs": {
      "location": "[location()]",
      "flavor": "[basics('flavor')]",
      "sqlServerEdition": "[basics('sqlServerEdition')]",
      "namingPrefix": "[basics('namingPrefix')]",
      "logAnalyticsWorkspaceName": "[basics('logAnalyticsWorkspaceName')]",
      "windowsAdminUsername": "[basics('windowsAdminUsername')]",
      "windowsAdminPassword": "[basics('windowsAdminPassword')]",
      "sshRSAPublicKey": "[basics('sshRSAPublicKey')]",
      "clientVmSize": "[steps('vm').clientVmSize]",
      "zones": "[steps('vm').zones]",
      "enableAzureSpotPricing": "[steps('vm').enableAzureSpotPricing]",
      "vmAutologon": "[steps('vm').vmAutologon]",
      "autoShutdownEnabled": "[steps('vm').autoShutdownEnabled]",
      "autoShutdownTime": "[steps('vm').autoShutdownTime]",
      "autoShutdownTimezone": "[steps('vm').autoShutdownTimezone]",
      "autoShutdownEmailRecipient": "[steps('vm').autoShutdownEmailRecipient]",
      "deployNatGateway": "[steps('network').deployNatGateway]",
      "deployBastion": "[steps('network').deployBastion]",
      "bastionSku": "[steps('network').bastionSku]",
      "rdpPort": "[steps('network').rdpPort]",
      "githubAccount": "[steps('advanced').githubAccount]",
      "githubBranch": "[steps('advanced').githubBranch]",
      "githubUser": "[steps('advanced').githubUser]",
      "vhdStorageAccountName": "[steps('advanced').vhdStorageAccountName]",
      "vhdStorageAccountResourceGroup": "[steps('advanced').vhdStorageAccountResourceGroup]",
      "vhdContainerName": "[steps('advanced').vhdContainerName]",
      "keyVaultName": "[steps('advanced').keyVaultName]",
      "debugEnabled": "[steps('advanced').debugEnabled]"
    }
  }
}
