{
  "$schema": "https://schema.management.azure.com/schemas/0.1.2-preview/CreateUIDefinition.MultiVm.json#",
  "handler": "Microsoft.Azure.CreateUIDef",
  "version": "0.1.2-preview",
  "parameters": {
    "config": {
      "isWizard": false,
      "basics": {
        "description": "Deploys Arc Jumpstart ArcBox. Pick the flavor here; the client VM size, networking and source settings are on the following tabs."
      }
    },
    "basics": [
      {
        "name": "flavor",
        "type": "Microsoft.Common.DropDown",
        "label": "ArcBox flavor",
        "defaultValue": "ITPro",
        "toolTip": "Which ArcBox scenario to deploy.",
        "constraints": {
          "allowedValues": [
            {
              "label": "ITPro",
              "value": "ITPro"
            },
            {
              "label": "DevOps",
              "value": "DevOps"
            },
            {
              "label": "DataOps",
              "value": "DataOps"
            }
          ],
          "required": true
        }
      },
      {
        "name": "sqlServerEdition",
        "type": "Microsoft.Common.DropDown",
        "label": "SQL Server edition",
        "defaultValue": "Developer",
        "toolTip": "Edition of SQL Server on the nested SQL VM.",
        "constraints": {
          "allowedValues": [
            {
              "label": "Developer",
              "value": "Developer"
            },
            {
              "label": "Standard",
              "value": "Standard"
            },
            {
              "label": "Enterprise",
              "value": "Enterprise"
            }
          ],
          "required": true
        }
      },
      {
        "name": "namingPrefix",
        "type": "Microsoft.Common.TextBox",
        "label": "Naming prefix",
        "defaultValue": "ArcBox",
        "toolTip": "Prefix for all resources and nested VMs (max 7 characters).",
        "constraints": {
          "required": true,
          "regex": "^[A-Za-z][A-Za-z0-9]{0,6}$",
          "validationMessage": "1-7 letters or numbers, starting with a letter."
        }
      },
      {
        "name": "logAnalyticsWorkspaceName",
        "type": "Microsoft.Common.TextBox",
        "label": "Log Analytics workspace name",
        "defaultValue": "ArcBox-la",
        "constraints": {
          "required": true,
          "regex": "^[A-Za-z0-9][A-Za-z0-9-]{2,61}[A-Za-z0-9]$",
          "validationMessage": "4-63 letters, numbers or hyphens."
        }
      },
      {
        "name": "windowsAdminUsername",
        "type": "Microsoft.Compute.UserNameTextBox",
        "label": "Windows admin username",
        "defaultValue": "arcdemo",
        "osPlatform": "Windows",
        "toolTip": "Admin account for the client VM.",
        "constraints": {
          "required": true
        }
      },
      {
        "name": "windowsAdminPassword",
        "type": "Microsoft.Common.PasswordBox",
        "label": {
          "password": "Windows admin password",
          "confirmPassword": "Confirm password"
        },
        "toolTip": "12-123 characters with upper case, lower case, a number and a special character.",
        "constraints": {
          "required": true,
          "regex": "^(?=.*[a-z])(?=.*[A-Z])(?=.*[0-9])(?=.*[^A-Za-z0-9]).{12,123}$",
          "validationMessage": "12-123 characters with upper case, lower case, a number and a special character."
        },
        "options": {
          "hideConfirmation": false
        }
      },
      {
        "name": "sshRSAPublicKey",
        "type": "Microsoft.Common.TextBox",
        "label": "SSH RSA public key",
        "multiLine": true,
        "toolTip": "Required for the DevOps and DataOps flavors (K3s/AKS Linux nodes).",
        "visible": "[not(equals(basics('flavor'), 'ITPro'))]",
        "constraints": {
          "required": "[not(equals(basics('flavor'), 'ITPro'))]"
        }
      }
    ],
    "steps": [
      {
        "name": "vm",
        "label": "Client VM",
        "elements": [
          {
            "name": "clientVmSize",
            "type": "Microsoft.Compute.SizeSelector",
            "label": "Client VM size",
            "toolTip": "Size of the ArcBox client VM that hosts the nested VMs. Limited to v5 or newer D/E-series x64 sizes with 8+ vCPUs and 32+ GB of memory.",
            "recommendedSizes": [
              "Standard_D8s_v7",
              "Standard_D16s_v7",
              "Standard_E8s_v7",
              "Standard_D8ds_v6",
              "Standard_D8s_v6"
            ],
            "constraints": {
              "allowedSizes": [
                "Standard_D8_v5",
                "Standard_D16_v5",
                "Standard_D32_v5",
                "Standard_D48_v5",
                "Standard_D64_v5",
                "Standard_D8ads_v5",
                "Standard_D16ads_v5",
                "Standard_D32ads_v5",
                "Standard_D48ads_v5",
                "Standard_D64ads_v5",
                "Standard_D8as_v5",
                "Standard_D16as_v5",
                "Standard_D32as_v5",
                "Standard_D48as_v5",
                "Standard_D64as_v5",
                "Standard_D8d_v5",
                "Standard_D16d_v5",
                "Standard_D32d_v5",
                "Standard_D48d_v5",
                "Standard_D64d_v5",
                "Standard_D8ds_v5",
                "Standard_D16ds_v5",
                "Standard_D32ds_v5",
                "Standard_D48ds_v5",
                "Standard_D64ds_v5",
                "Standard_D16lds_v5",
                "Standard_D32lds_v5",
                "Standard_D48lds_v5",
                "Standard_D64lds_v5",
                "Standard_D16ls_v5",
                "Standard_D32ls_v5",
                "Standard_D48ls_v5",
                "Standard_D64ls_v5",
                "Standard_D8s_v5",
                "Standard_D16s_v5",
                "Standard_D32s_v5",
                "Standard_D48s_v5",
                "Standard_D64s_v5",
                "Standard_E8_v5",
                "Standard_E16_v5",
                "Standard_E20_v5",
                "Standard_E32_v5",
                "Standard_E48_v5",
                "Standard_E64_v5",
                "Standard_E8ads_v5",
                "Standard_E16ads_v5",
                "Standard_E20ads_v5",
                "Standard_E32ads_v5",
                "Standard_E48ads_v5",
                "Standard_E64ads_v5",
                "Standard_E8as_v5",
